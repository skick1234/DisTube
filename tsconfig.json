{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node", "bun"],
    "target": "ESNext",
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "newLine": "lf",
    "removeComments": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "distube": ["./packages/distube/src/index.ts"],
      "@distube/discordjs": ["./packages/discordjs/src/index.ts"],
      "@distube/oceanic": ["./packages/oceanic/src/index.ts"],
      "@distube/voice-core": ["./packages/voice-core/src/index.ts"],
      "distube/integrations": ["./packages/distube/src/integrations.ts"]
    }
  }
}
