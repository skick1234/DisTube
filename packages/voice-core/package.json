{
  "name": "@distube/voice-core",
  "version": "6.0.0",
  "private": true,
  "description": "Platform-neutral and @discordjs/voice implementations shared by the official adapters; bundled into their builds and never published",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/index.ts",
    "./discord": "./src/discord.ts"
  },
  "scripts": {
    "check": "oxlint --deny-warnings && oxfmt --check",
    "type": "tsrs --noEmit",
    "test": "vitest run --coverage=false",
    "test:release": "vitest run --coverage"
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "distube": "workspace:*",
    "node-av": "6.2.0-beta.33"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
