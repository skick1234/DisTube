{
  "name": "@distube/voice-core",
  "version": "6.0.0",
  "description": "Private @discordjs/voice implementation shared by @distube/discordjs and @distube/oceanic; bundled into their builds and never published",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "biome check .",
    "type": "tsc --noEmit",
    "test": "vitest run --coverage=false",
    "test:release": "vitest run --coverage",
    "check:circular": "dpdm -T --tree=false --warning=false --exit-code circular:1 --tsconfig tsconfig.json \"src/**/*.ts\""
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "distube": "workspace:*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT"
}
