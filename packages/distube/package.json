{
  "name": "distube",
  "version": "6.0.0",
  "description": "Minimal queue and playback orchestration for Discord audio",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./integrations": {
      "types": "./dist/integrations.d.mts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "type": "tsc --noEmit",
    "test": "vitest run --coverage=false",
    "test:release": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "bun run build"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "sourceEntries": {
    ".": "./src/index.ts",
    "./integrations": "./src/integrations.ts"
  }
}
