{
  "name": "@distube/eris",
  "version": "6.0.0",
  "description": "Eris Adapter and Player for DisTube",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "check": "oxlint --deny-warnings && oxfmt --check",
    "type": "tsrs --noEmit",
    "test": "vitest run --coverage=false",
    "test:release": "vitest run --coverage",
    "build": "tsdown && bun ../../scripts/sanitize-adapter-output.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "node-av": "6.2.0-beta.33"
  },
  "devDependencies": {
    "distube": "workspace:*",
    "eris": "^0.18.0"
  },
  "peerDependencies": {
    "distube": "^6.0.0",
    "eris": "^0.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
