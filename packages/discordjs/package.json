{
  "name": "@distube/discordjs",
  "version": "0.0.0",
  "description": "discord.js adapter for DisTube",
  "homepage": "https://distube.js.org/",
  "bugs": {
    "url": "https://github.com/skick1234/DisTube/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skick1234/DisTube.git",
    "directory": "packages/discordjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "oxlint --deny-warnings && oxfmt --check",
    "type": "tsrs --noEmit",
    "test": "tsdown && vitest run --coverage=false",
    "test:release": "tsdown && vitest run --coverage",
    "build": "tsdown",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1"
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "distube": "workspace:*"
  },
  "peerDependencies": {
    "@discordjs/voice": "^0.19.1",
    "discord.js": "^14.26.0",
    "distube": "^6.0.0"
  },
  "optionalDependencies": {
    "node-av": "6.2.0-beta.35"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
