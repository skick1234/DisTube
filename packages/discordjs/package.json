{
  "name": "@distube/discordjs",
  "version": "6.0.0-dev.0",
  "description": "discord.js Adapter and Player for DisTube",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "type": "tsc --noEmit",
    "test": "vitest run --coverage=false",
    "build": "tsdown && bun ../../scripts/clean-source-declarations.ts",
    "check:circular": "dpdm --tree=false --warning=false --exit-code circular:1 --tsconfig tsconfig.json \"src/**/*.ts\"",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.26.0",
    "distube": "^6.0.0-dev.0"
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "distube": "workspace:*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT"
}
