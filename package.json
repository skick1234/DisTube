{
  "name": "distube-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "bun ./scripts/check-runtime.ts",
    "check": "biome check . && bun run check:boundaries",
    "check:write": "biome check . --write --unsafe",
    "check:boundaries": "bun test ./scripts/source-structure.test.ts && bun ./scripts/check-boundaries.ts",
    "check:audit": "bun test ./scripts/audit-scope.test.ts && bun ./scripts/check-audit.ts",
    "check:dependencies": "bun ./scripts/check-dependencies.ts",
    "check:circular": "bun run --filter '*' check:circular",
    "type": "bun run --filter '*' type",
    "check:test-inventory": "bun ./scripts/check-test-inventory.ts",
    "test": "bun run check:test-inventory && bun run --filter '*' test",
    "build": "bun ./scripts/build-packages.ts",
    "api-report": "bun ./scripts/generate-api-reports.ts",
    "api-report:prepared": "bun ./scripts/generate-api-reports.ts --prepared",
    "api-extractor": "api-extractor run --local --config packages/distube/api-extractor.json",
    "check:packages": "bun ./scripts/check-packages.ts",
    "check:packages:prepared": "bun ./scripts/check-packages.ts --prepared",
    "check:local-playback": "bun ./scripts/check-local-playback.ts",
    "check:adapter-compatibility": "bun test ./scripts/peer-boundaries.test.ts && bun ./scripts/check-adapter-compatibility.ts",
    "check:adapter-compatibility:prepared": "bun test ./scripts/peer-boundaries.test.ts && bun ./scripts/check-adapter-compatibility.ts --prepared",
    "check:playback-contract": "bun ./scripts/check-playback-contract.ts",
    "check:release-inputs": "bun run check:runtime && bun ./scripts/check-release-inputs.ts",
    "check:publish-authorization": "bun run check:runtime && bun ./scripts/check-publish-authorization.ts",
    "check:workflows": "bun test ./scripts/check-publish-authorization.test.ts ./scripts/check-workflows.test.ts ./scripts/extract-release-candidate.test.ts && bun ./scripts/check-workflows.ts",
    "docs": "bun ./scripts/generate-docs.ts",
    "docs:prepared": "bun ./scripts/generate-docs.ts --prepared",
    "test:release": "bun run check:test-inventory && bun run --filter '*' test:release",
    "check:critical-quality": "bun ./scripts/check-critical-quality.ts",
    "check:prepared-build": "bun test ./scripts/prepared-build.test.ts",
    "verify": "bun run check:runtime && bun run check && bun run check:dependencies && bun run type && bun run test:release && bun run build && bun run check:prepared-build && bun run check:circular && bun run api-report:prepared && bun run check:packages:prepared && bun run check:local-playback && bun run check:adapter-compatibility:prepared && bun run docs:prepared && bun run check:critical-quality && bun run check:audit && bun run check:workflows",
    "version-packages": "bun run check:runtime && changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "@discordjs/voice": "^0.19.2",
    "@distube/voice-core": "workspace:*",
    "@microsoft/api-extractor": "^7.58.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "discord.js": "^14.27.0",
    "dpdm": "^4.2.0",
    "eris": "^0.18.0",
    "oceanic.js": "^1.14.0",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild",
    "ffmpeg-static"
  ]
}
