{
  "name": "distube-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "bun ./scripts/check-runtime.ts",
    "check": "biome check . && bun run check:boundaries",
    "check:write": "biome check . --write --unsafe",
    "check:boundaries": "bun ./scripts/check-boundaries.ts",
    "check:audit": "bun ./scripts/check-audit.ts",
    "check:dependencies": "bun ./scripts/check-dependencies.ts",
    "check:circular": "bun run --filter '*' check:circular",
    "type": "bun run --filter '*' type",
    "check:test-inventory": "bun ./scripts/check-test-inventory.ts",
    "test": "bun run check:test-inventory && bun run --filter '*' test",
    "build": "bun run --cwd packages/distube build && bun run --cwd packages/discordjs build && bun run --cwd packages/oceanic build && bun run --cwd packages/eris build",
    "api-report": "bun run build && bun ./scripts/generate-api-reports.ts",
    "api-extractor": "api-extractor run --local --config packages/distube/api-extractor.json",
    "check:packages": "bun ./scripts/check-packages.ts",
    "check:adapter-compatibility": "bun ./scripts/check-adapter-compatibility.ts",
    "check:playback-contract": "bun ./scripts/check-playback-contract.ts",
    "check:release-inputs": "bun run check:runtime && bun ./scripts/check-release-inputs.ts",
    "check:publish-authorization": "bun run check:runtime && bun ./scripts/check-publish-authorization.ts",
    "check:workflows": "bun test ./scripts/check-workflows.test.ts && bun ./scripts/check-workflows.ts",
    "docs": "bun ./scripts/generate-docs.ts",
    "test:mutation": "bun run --cwd packages/distube test:mutation",
    "verify": "bun run check:runtime && bun run check && bun run check:dependencies && bun run type && bun run test && bun run build && bun run check:circular && bun run api-report && bun run check:packages && bun run check:adapter-compatibility && bun run docs && bun run test:mutation && bun run check:audit && bun run check:workflows",
    "changeset": "changeset",
    "version-packages": "bun run check:runtime && changeset version",
    "release": "bun run check:runtime && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "@discordjs/voice": "^0.19.2",
    "@microsoft/api-extractor": "^7.58.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "discord.js": "^14.27.0",
    "dpdm": "^4.2.0",
    "eris": "^0.18.0",
    "oceanic.js": "^1.14.0",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild",
    "ffmpeg-static"
  ]
}
