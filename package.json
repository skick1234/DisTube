{
  "name": "distube-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "oxlint --deny-warnings && oxfmt --check",
    "check:write": "oxlint --fix && oxfmt",
    "type": "bun run --filter '*' type",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "api-extractor": "api-extractor run --local --config packages/distube/api-extractor.json",
    "docs": "bun run build && bun run api-extractor && bun scripts/generate-docs.ts && rm -rf docs && bunx vitepress build website --outDir docs",
    "test:release": "bun run --filter '*' test:release",
    "verify": "bun run check && bun run type && bun run test:release && bun run build",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@discordjs/voice": "^0.19.2",
    "@distube/voice-core": "workspace:*",
    "@microsoft/api-extractor": "^7.58.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "discord.js": "^14.27.0",
    "eris": "^0.18.0",
    "oceanic.js": "^1.14.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild",
    "ffmpeg-static"
  ]
}
